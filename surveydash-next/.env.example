BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3100
STUDIO_DB_PATH=.data/studio.sqlite
# Cloud: use a PostgreSQL connection string. SQLite remains the local fallback.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# TRUST_PROXY=true
# Preview deployments require an isolated database and never use the production fallback.
# STAGING_DATABASE_URL=postgresql://user:password@staging-host:5432/database?sslmode=require
# Optional usage limits, disabled during Free beta unless explicitly enabled.
# ENFORCE_FREE_LIMITS=false
# FREE_RESPONSE_LIMIT=100
# FREE_ACTIVE_SURVEY_LIMIT=3
SUPPORT_EMAIL=help@surveydash.id
# Recommended dedicated stable key (32+ random characters) for surveyor payout encryption.
# Defaults to BETTER_AUTH_SECRET; preserve the effective key with private backups.
# SURVEYOR_DATA_SECRET=
# Enable recovery only after the SMTP sender and delivery have been verified.
PASSWORD_RECOVERY_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false
# Separate backup key, at least 32 random characters. Keep a protected recovery copy outside backup storage.
# BACKUP_ENCRYPTION_KEY=
# Optional cloud migration guard: SHA-256 of the exact target DATABASE_URL (never put the URL in chat).
# MIGRATION_EXPECTED_DATABASE_SHA256=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=help@surveydash.id
# SMTP_TEST_MODE=true is restricted to loopback hosts outside production.
# Enable the Google Forms API and register the callback in your own Google OAuth project.
# Read-only scopes: forms.body.readonly AND forms.responses.readonly. Existing connections must renew consent to import responses.
# GOOGLE_FORMS_CLIENT_ID=
# GOOGLE_FORMS_CLIENT_SECRET=
